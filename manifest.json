{
  "manifest_version": 3,
  "name": "优课学习助手",
  "version": "2.1.5",
  "description": "优课与学习通课程连播、倍速、习题辅助填写、学习统计、课程成绩和本机登录保持。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://uooc.net.cn/*",
        "https://*.uooc.net.cn/*",
        "http://uooc.net.cn/*",
        "http://*.uooc.net.cn/*"
      ],
      "js": [
        "videojs-compat.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://uooc.net.cn/*",
        "https://*.uooc.net.cn/*",
        "http://uooc.net.cn/*",
        "http://*.uooc.net.cn/*"
      ],
      "js": [
        "platforms.js",
        "settings.js",
        "course-parser.js",
        "course-reader.js",
        "uooc-adapter.js",
        "quiz-submit.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.chaoxing.com/*",
        "http://*.chaoxing.com/*"
      ],
      "js": [
        "platforms.js",
        "settings.js",
        "chaoxing-parser.js",
        "chaoxing-reader.js",
        "chaoxing-adapter.js",
        "quiz-submit.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fycourse.fanya.chaoxing.com/fyportal/courselist/course*",
        "https://*.chaoxing.com/mycourse/studentstudy*",
        "https://*.chaoxing.com/mooc-ans/mycourse/studentstudy*",
        "https://passport2.chaoxing.com/login*",
        "https://v8.chaoxing.com/*"
      ],
      "js": [
        "chaoxing-parser.js",
        "chaoxing-account.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://www.uooc.net.cn/*",
    "https://uooc.net.cn/*",
    "*://*.uooc.net.cn/*",
    "*://*.chaoxing.com/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*"
  ]
}
